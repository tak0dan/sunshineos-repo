# Maintainer: tak0dan
pkgname=sunshine-base
pkgver=0.8
pkgrel=1
pkgdesc="Sunshine OS tools, hooks, identity, store and package lists for an Arch based system"
arch=('any')
url="https://github.com/tak0dan/SunshineOS"
license=('MIT')
depends=('bash' 'sudo' 'rsync' 'git' 'python' 'uni-pkg-git' 'snapper')
optdepends=('sunshine-payload: the Hyprland desktop (dots, Python venv)')
backup=('etc/sunshine/snapshots.conf')
source=(sunshine-base-src.tar.zst)
sha256sums=('SKIP')
noextract=(sunshine-base-src.tar.zst)

package() {
  tar --zstd -xf "$srcdir/sunshine-base-src.tar.zst" -C "$pkgdir" --no-same-owner
  chmod 755 "$pkgdir"/usr/bin/sunshine-* "$pkgdir/etc/grub.d/42_nixos"
}
